// Cloudflare Workers (static assets) config. Build first with `npm run generate`.
// Cloudflare Pages ignores this file and uses its dashboard settings instead.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-nuxt",
	"compatibility_date": "2025-07-15",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
